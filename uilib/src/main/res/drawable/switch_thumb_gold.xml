<?xml version="1.0" encoding="utf-8"?>
<!-- 暗调禅金开关：滑块。开=深底，关=暖灰，与轨道形成足够对比 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                    <solid android:color="@color/c_bg_page" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                    <solid android:color="@color/c_text_second" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
