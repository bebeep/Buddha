<?xml version="1.0" encoding="utf-8"?>
<!--
    时刻选择的小时格：选中=禅金实底 + 深字，未选=暗棕底 + 米字。
    不用滚轮是因为一天只给 06:00-20:00 这 15 个选项，格子比滚轮少两次操作。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/c_gold" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/c_line" />
            <corners android:radius="8dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/c_gold_20" />
        </shape>
    </item>

</selector>
