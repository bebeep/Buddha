<resources>

    <style name="launch" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--启动的activity 的style-->
    <style name="launch.startup" parent="launch">
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@drawable/bg_startup</item>
    </style>

    <style name="style_clickable">
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="roundedCornerImage_15dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <!--
        商城分类 chip 基础样式（未选中态）。
        选中态由代码切成 bg_shop_chip_on + 深色字，样式里只放尺寸与默认配色。
    -->
    <style name="shop_chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_home_pill_solid</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#B5A78F</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>