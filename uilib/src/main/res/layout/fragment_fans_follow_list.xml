<?xml version="1.0" encoding="utf-8"?>
<!--
    粉丝 / 关注列表：两个 tab 支持左右滑动切换，
    复用收藏页的 ScaleTabLayout + ViewPager 范式。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">



        <com.fingertip.baselib.view.tablayout.ScaleTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_back"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:tl_indicator_color="@color/c_gold"
            app:tl_indicator_corner_radius="16dp"
            app:tl_indicator_height="3dp"
            app:tl_indicator_horizontal="CENTER"
            app:tl_indicator_width="18dp"
            app:tl_tab_padding="12dp"
            app:tl_textBold="BOTH"
            app:tl_textsize="16sp"
            app:tl_textSelectColor="@color/c_gold_light"
            app:tl_textUnselectColor="@color/c_text_second" />

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>



    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_fans_follow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
