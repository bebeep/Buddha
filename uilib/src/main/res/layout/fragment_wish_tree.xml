<?xml version="1.0" encoding="utf-8"?>
<!--
    许愿树主页（改版）：全屏许愿树背景，愿签牌挂在树冠以下、主干两侧的横向树杈上随风摆动。
    树上最多 9 张，真实愿望不足时用不可点击的装饰牌补满。
    点击愿签牌查看他人公开愿望（可祝福、可点赞）；底部开始许愿进编辑页，
    提交成功返回本页，播放愿签牌从底部飞上树的动画。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wish_tree_bg">

    <!-- 全屏许愿树佛光背景 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wish_tree_light" />
    <!-- 全屏许愿树 -->
    <ImageView
        android:id="@+id/iv_tree"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/bg_wish_tree" />

    <!-- 愿签牌容器：覆盖整棵树 -->
    <FrameLayout
        android:id="@+id/fl_tags"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏：返回 / 标题 / 规则，透明浮在树上 -->
    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/icon_back_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="许愿树"
            android:textColor="@color/c_text_main"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <TextView
            android:id="@+id/tv_rule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:padding="4dp"
            android:text="许愿规则"
            android:textColor="@color/wish_tree_text"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 我的愿望 / 我的祝愿入口：半透明小胶囊浮在树上 -->
    <LinearLayout
        android:id="@+id/ll_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <TextView
            android:id="@+id/tv_my_wish"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_wish_entry"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="我的愿望"
            android:textColor="@color/wish_tree_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_my_bless"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_wish_entry"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="我的祝愿"
            android:textColor="@color/wish_tree_text"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 空态提示：树上没有愿签牌时 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="许愿树还空着，来挂上第一个愿签吧"
        android:textColor="@color/wish_tree_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tv_post_wish"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title" />

    <!-- 底部开始许愿 -->
    <TextView
        android:id="@+id/tv_post_wish"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_sign_button"
        android:elevation="4dp"
        android:gravity="center"
        android:text="开始许愿"
        android:textColor="@color/c_text_on_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
