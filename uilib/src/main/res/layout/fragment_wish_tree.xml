<?xml version="1.0" encoding="utf-8"?>
<!--
    许愿树主页，对应原型「许愿树-主页」：
    标题栏（返回+许愿+规则）、我的愿望/我的祝愿入口、愿望卡瀑布、底部开始许愿
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7EA">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@mipmap/icon_back_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="许愿"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <TextView
            android:id="@+id/tv_rule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:padding="4dp"
            android:text="许愿规则"
            android:textColor="#FFA030"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 我的愿望 / 我的祝愿入口 -->
    <LinearLayout
        android:id="@+id/ll_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <TextView
            android:id="@+id/tv_my_wish"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wish_entry"
            android:gravity="center"
            android:text="我的愿望"
            android:textColor="#2C1900"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_my_bless"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wish_entry"
            android:gravity="center"
            android:text="我的祝愿"
            android:textColor="#2C1900"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 愿望卡：两列网格，点击弹详情送祝福 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_post_wish"
        app:layout_constraintTop_toBottomOf="@+id/ll_entry">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_wish_tree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="许愿树空空如也，来写下第一个愿望吧"
        android:textColor="#B08A4A"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tv_post_wish"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_entry" />

    <!-- 底部开始许愿 -->
    <TextView
        android:id="@+id/tv_post_wish"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_sign_button"
        android:gravity="center"
        android:text="开始许愿"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
