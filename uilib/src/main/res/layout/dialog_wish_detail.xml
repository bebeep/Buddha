<?xml version="1.0" encoding="utf-8"?>
<!-- 愿望详情底部弹窗：查看他人公开愿望，可点赞、可祝福 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sign_info_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="愿签"
        android:textColor="@color/c_text_third"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 许愿人 + 时间 -->
    <TextView
        android:id="@+id/tv_wisher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/c_text_second"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_wish_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_wish_card"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/c_text_third"
        android:textSize="14sp" />

    <!-- 点赞行 -->
    <LinearLayout
        android:id="@+id/ll_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/tv_like_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤍"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0"
            android:textColor="@color/c_text_second"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="为这个愿望点赞"
            android:textColor="@color/c_text_hint"
            android:textSize="12sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_bless_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="start|top"
        android:hint="写下你的祝福（必填）"
        android:maxLength="255"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="@color/c_text_third"
        android:textColorHint="@color/c_text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_bless_submit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_sign_button"
        android:gravity="center"
        android:text="祝愿"
        android:textColor="@color/c_text_on_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
