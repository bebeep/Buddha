<?xml version="1.0" encoding="utf-8"?>
<!-- 愿望详情底部弹窗：查看他人公开愿望，可点赞、可祝福 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sign_info_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="愿签"
        android:textColor="@color/c_text_third"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 匿名标识：仅匿名时显示，隐藏整块用户信息 -->
    <TextView
        android:id="@+id/tv_wisher_anonymous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_wish_anonymous_tag"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="匿名用户"
        android:textColor="@color/c_text_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 许愿人信息区（非匿名）：头像 + 头像框 + 昵称 + 等级 + 称号 -->
    <LinearLayout
        android:id="@+id/ll_wisher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 头像 + 头像框（叠加层，预留） -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <com.fingertip.baselib.view.CircleImageView
                android:id="@+id/iv_wisher_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:civ_border_width="1.5dp"
                app:civ_border_color="@color/c_gold" />

            <!-- 头像框：比头像略大居中叠放，后端下发 avatarFrame 时显示 -->
            <ImageView
                android:id="@+id/iv_wisher_frame"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 昵称 / 等级 / 称号 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_wisher_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxEms="10"
                    android:singleLine="true"
                    android:textColor="@color/c_text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 等级标签：后端下发 userLevel>0 时显示 -->
                <TextView
                    android:id="@+id/tv_wisher_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_wish_level_tag"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/c_gold"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <!-- 称号标签：后端下发 userTitle 时显示 -->
                <TextView
                    android:id="@+id/tv_wisher_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_wish_title_tag"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 许愿时间：匿名 / 非匿名都显示 -->
    <TextView
        android:id="@+id/tv_wish_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/c_text_hint"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_wish_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/c_text_third"
        android:textSize="14sp" />

    <!-- 点赞行 -->
    <LinearLayout
        android:id="@+id/ll_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/tv_like_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤍"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0"
            android:textColor="@color/c_text_second"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="为这个愿望点赞"
            android:textColor="@color/c_text_hint"
            android:textSize="12sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_bless_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="start|top"
        android:hint="写下你的祝福（必填）"
        android:maxLength="255"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="@color/c_text_third"
        android:textColorHint="@color/c_text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_bless_submit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_sign_button"
        android:gravity="center"
        android:text="祝愿"
        android:textColor="@color/c_text_on_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
