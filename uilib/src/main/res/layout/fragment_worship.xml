<?xml version="1.0" encoding="utf-8"?>
<!--
    拜佛 tab：纯场景页。

    场景为 2D 全分层结构（分层在轮播单页内部 item_buddha_page.xml）：
    佛龛 + 佛龛动画 + 佛光 + 佛像 + 净瓶 + 贡品 + 香烛 + 佛灯，随轮播一体滑动。
    原底部「点一盏灯卡片 + 灯油/灯具/佛龛三格」已移除——与场景内佛灯/佛龛点击重复：
    点场景里的佛龛/佛灯直接进装扮（已拥有→我的装扮，未拥有→商城分类），
    灯没油或将熄时点佛灯直达灯油分类续燃。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <!-- 佛龛轮播区域（全屏）：ViewPager2 手指跟手滑动，无限循环 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_buddha"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部导航栏（悬浮在场景上方） -->
    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/worship_title"
            android:textColor="@color/c_text_main"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 当前佛像信息：名字 + 庇佑标签 + 供奉入口（点头像区进佛像详情） -->
    <LinearLayout
        android:id="@+id/ll_buddha_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_buddha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/c_text_main"
                android:textSize="20sp"
                app:zdyFont="bold" />

            <LinearLayout
                android:id="@+id/ll_buddha_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_worship_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/worship_offer_action"
            android:textColor="@color/c_gold"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
