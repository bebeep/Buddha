<?xml version="1.0" encoding="utf-8"?>
<!--
    购买确认弹窗（暗调版）
    只展示商品名、价格、时长和一句开发环境的模拟支付提示，
    真实扣款金额以商店支付页为准——所以这里刻意不写「应付」字样，避免和商店价格不一致时被用户投诉。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fingertip.baselib.view.shapeview.ShapeConstraintLayout
        android:id="@+id/cl_content"
        style="@style/constraint_center"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        app:gdBgColor="@color/c_line"
        app:gdRadius="14dp">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/shop_pay_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textColor="@color/c_text_main"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/c_gold"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_item"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/c_text_second"
            android:textSize="10.5sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_price" />

        <LinearLayout
            android:id="@+id/ll_buttons"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_hint">

            <com.fingertip.baselib.view.shapeview.ShapeTextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/shop_pay_cancel"
                android:textColor="@color/c_text_third"
                android:textSize="14sp"
                app:gdBgColor="@color/c_stroke_soft"
                app:gdRadius="22dp"
                app:zdyFont="bold" />

            <com.fingertip.baselib.view.shapeview.ShapeTextView
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/shop_pay_confirm"
                android:textColor="@color/c_text_on_gold"
                android:textSize="14sp"
                app:gdBgColor="@color/c_gold"
                app:gdRadius="22dp"
                app:zdyFont="bold" />
        </LinearLayout>

    </com.fingertip.baselib.view.shapeview.ShapeConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
