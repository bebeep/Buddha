<?xml version="1.0" encoding="utf-8"?>
<!--
    我的收藏
    三类目标（佛经/感悟/寺庙）共用一个列表，顶部 chip 做筛选。
    用 chip 而不是 TabLayout：只有四项、且都是同一列表的过滤条件，不值得上重量级控件。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/collect_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab_all"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_collect_tab_on"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/collect_tab_all"
            android:textColor="@color/c_gold_light"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab_sutra"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_collect_tab_off"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/collect_tab_sutra"
            android:textColor="@color/c_text_second"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab_moment"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_collect_tab_off"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/collect_tab_moment"
            android:textColor="@color/c_text_second"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab_temple"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_collect_tab_off"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/collect_tab_temple"
            android:textColor="@color/c_text_second"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_collect"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_tabs" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collect_empty"
        android:textColor="@color/c_text_hint"
        android:textSize="12.5sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
