<?xml version="1.0" encoding="utf-8"?>
<!--
    首页区块 6：佛友圈精选（占位）
    精选源要等运营推荐池上线，先把入口和文案铺好；
    「查看全部」切到佛友圈 tab，不新开页面。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_home_card_a"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.04"
            android:text="@string/home_block_moment"
            android:textColor="#EDE3D2"
            android:textSize="13sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_moment_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_moment_more"
            android:textColor="#C4A265"
            android:textSize="10.5sp" />

    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_moment_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_inner"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:text="@string/home_moment_empty"
        android:textColor="#B5A78F"
        android:textSize="11.5sp" />

</LinearLayout>
