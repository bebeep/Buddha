<?xml version="1.0" encoding="utf-8"?>
<!--
  签到弹窗。内容全部由接口驱动：
  连签天数、累计签到、每次签到的基础奖励、下一档连签奖励。
  7 格「第一天～第七天」的写法表达不了 7/30/90/180/365 这些档位，换成了进度条。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fingertip.baselib.view.shapeview.ShapeConstraintLayout
        android:id="@+id/cl_content"
        style="@style/constraint_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        app:gdBgColor="#FFFEFA"
        app:gdRadius="8dp">

        <ImageView
            android:id="@+id/iv_bg_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@mipmap/bg_dialog_sign_in_top" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每日签到"
            android:textColor="#FFFEFA"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_bg_top"
            app:layout_constraintEnd_toEndOf="@+id/iv_bg_top"
            app:layout_constraintStart_toStartOf="@+id/iv_bg_top"
            app:layout_constraintTop_toTopOf="@+id/iv_bg_top"
            app:zdyFont="bold" />

        <!-- 已连续签到天数 -->
        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_days_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="已连续签到"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_bg_top" />

        <LinearLayout
            android:id="@+id/ll_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal|bottom"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_days_title">

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_continuous_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFA030"
                android:textSize="40sp"
                app:zdyFont="bold" />

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingBottom="6dp"
                android:text="天"
                android:textColor="#2C1900"
                android:textSize="14sp" />
        </LinearLayout>

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_total_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="累计签到 0 天"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_days" />

        <!-- 每次签到都给的基础奖励，两张卡片，接口只给一种时第二张隐藏 -->
        <LinearLayout
            android:id="@+id/ll_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_days">

            <LinearLayout
                android:id="@+id/ll_reward_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_sign_in_item"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_reward_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="金币"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_reward_value_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+1"
                    android:textColor="#FFA030"
                    android:textSize="18sp"
                    app:zdyFont="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_reward_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sign_in_item"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_reward_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修行值"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_reward_value_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+1"
                    android:textColor="#FFA030"
                    android:textSize="18sp"
                    app:zdyFont="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 下一档连续签到奖励 -->
        <LinearLayout
            android:id="@+id/ll_continuous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/ll_daily">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_continuous_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="连续签到奖励"
                    android:textColor="#2C1900"
                    android:textSize="13sp"
                    app:zdyFont="bold" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_continuous_remain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="还差 7 天"
                    android:textColor="#FFA030"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_continuous"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_sign_in_progress" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_continuous_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="再签 7 天，额外得 金币 +5"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <com.hjq.shape.layout.ShapeConstraintLayout
            android:id="@+id/cl_shadow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_continuous"
            app:shape_endColor="#FFD543"
            app:shape_radius="24dp"
            app:shape_shadowColor="#8CFFCE53"
            app:shape_shadowOffsetY="4dp"
            app:shape_shadowSize="8dp"
            app:shape_solidPressedColor="#FFA030"
            app:shape_startColor="#FFA030">

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_sign_in"
                style="@style/constraint_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="签到领取 金币 +1"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:zdyFont="bold" />
        </com.hjq.shape.layout.ShapeConstraintLayout>
    </com.fingertip.baselib.view.shapeview.ShapeConstraintLayout>

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:src="@mipmap/icon_sign_in_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_content" />
</androidx.constraintlayout.widget.ConstraintLayout>
