<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rec_top_24dp"
    android:padding="24dp">

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_color_text"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="正文"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_text_color_1"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_text_color_1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_color_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_text_color_2"
        app:layout_constraintStart_toEndOf="@+id/tv_color_text"
        app:layout_constraintTop_toTopOf="@+id/tv_color_text" />

    <ImageView
        android:id="@+id/iv_text_color_2"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_text_color_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_color_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_text_color_3"
        app:layout_constraintStart_toEndOf="@+id/iv_text_color_1"
        app:layout_constraintTop_toTopOf="@+id/tv_color_text" />

    <ImageView
        android:id="@+id/iv_text_color_3"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_text_color_3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_color_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_text_color_4"
        app:layout_constraintStart_toEndOf="@+id/iv_text_color_2"
        app:layout_constraintTop_toTopOf="@+id/tv_color_text" />

    <ImageView
        android:id="@+id/iv_text_color_4"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_text_color_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_color_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_text_color_3"
        app:layout_constraintTop_toTopOf="@+id/tv_color_text" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_bg"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="背景"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_color_text" />

    <ImageView
        android:id="@+id/iv_bg_color_1"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_color_1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_bg_color_2"
        app:layout_constraintStart_toEndOf="@+id/tv_bg"
        app:layout_constraintTop_toTopOf="@+id/tv_bg" />

    <ImageView
        android:id="@+id/iv_bg_color_2"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_color_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_bg_color_3"
        app:layout_constraintStart_toEndOf="@+id/iv_bg_color_1"
        app:layout_constraintTop_toTopOf="@+id/tv_bg" />

    <ImageView
        android:id="@+id/iv_bg_color_3"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_color_3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_bg_color_4"
        app:layout_constraintStart_toEndOf="@+id/iv_bg_color_2"
        app:layout_constraintTop_toTopOf="@+id/tv_bg" />

    <ImageView
        android:id="@+id/iv_bg_color_4"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_color_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_bg_color_3"
        app:layout_constraintTop_toTopOf="@+id/tv_bg" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_fontsize"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="字号"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_bg" />

    <com.fingertip.baselib.view.shapeview.ShapeView
        android:id="@+id/v_font_bg"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:gdBgColor="#F7F7F7"
        app:gdRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_fontsize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_fontsize"
        app:layout_constraintTop_toTopOf="@+id/tv_fontsize" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_font1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="小"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_font_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_font2"
        app:layout_constraintStart_toStartOf="@+id/v_font_bg"
        app:layout_constraintTop_toTopOf="@+id/v_font_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_font2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="中"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_font_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_font3"
        app:layout_constraintStart_toEndOf="@+id/tv_font1"
        app:layout_constraintTop_toTopOf="@+id/v_font_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_font3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="大"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_font_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_font4"
        app:layout_constraintStart_toEndOf="@+id/tv_font2"
        app:layout_constraintTop_toTopOf="@+id/v_font_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_font4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="特大"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_font_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_font_bg"
        app:layout_constraintStart_toEndOf="@+id/tv_font3"
        app:layout_constraintTop_toTopOf="@+id/v_font_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_linespacing"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="行距"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_fontsize" />

    <com.fingertip.baselib.view.shapeview.ShapeView
        android:id="@+id/v_line_bg"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:gdBgColor="#F7F7F7"
        app:gdRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_linespacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_linespacing"
        app:layout_constraintTop_toTopOf="@+id/tv_linespacing" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_line1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="紧"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_line_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_line2"
        app:layout_constraintStart_toStartOf="@+id/v_line_bg"
        app:layout_constraintTop_toTopOf="@+id/v_line_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_line2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="标准"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_line_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_line3"
        app:layout_constraintStart_toEndOf="@+id/tv_line1"
        app:layout_constraintTop_toTopOf="@+id/v_line_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_line3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="宽"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_line_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_line4"
        app:layout_constraintStart_toEndOf="@+id/tv_line2"
        app:layout_constraintTop_toTopOf="@+id/v_line_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_line4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="疏"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_line_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_line_bg"
        app:layout_constraintStart_toEndOf="@+id/tv_line3"
        app:layout_constraintTop_toTopOf="@+id/v_line_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_keep"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="常亮"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_linespacing" />

    <com.fingertip.baselib.view.shapeview.ShapeView
        android:id="@+id/v_keep_bg"
        android:layout_width="96dp"
        android:layout_height="24dp"
        app:gdBgColor="#F7F7F7"
        app:gdRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_keep"
        app:layout_constraintStart_toEndOf="@+id/tv_keep"
        app:layout_constraintTop_toTopOf="@+id/tv_keep" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_keep_on"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="开"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_keep_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_keep_bg"
        app:layout_constraintStart_toStartOf="@+id/v_keep_bg"
        app:layout_constraintTop_toTopOf="@+id/v_keep_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_trad_label"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="字形"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_keep" />

    <com.fingertip.baselib.view.shapeview.ShapeView
        android:id="@+id/v_trad_bg"
        android:layout_width="96dp"
        android:layout_height="24dp"
        app:gdBgColor="#F7F7F7"
        app:gdRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trad_label"
        app:layout_constraintStart_toEndOf="@+id/tv_trad_label"
        app:layout_constraintTop_toTopOf="@+id/tv_trad_label" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_trad_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="简体"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_trad_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_trad_bg"
        app:layout_constraintStart_toStartOf="@+id/v_trad_bg"
        app:layout_constraintTop_toTopOf="@+id/v_trad_bg"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_offline"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="离线"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_trad_label" />

    <com.fingertip.baselib.view.shapeview.ShapeView
        android:id="@+id/v_offline_bg"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:gdBgColor="#F7F7F7"
        app:gdRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_offline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_offline"
        app:layout_constraintTop_toTopOf="@+id/tv_offline" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_offline_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@drawable/bg_font_size"
        android:gravity="center"
        android:text="下载整部"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/v_offline_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_offline_bg"
        app:layout_constraintStart_toStartOf="@+id/v_offline_bg"
        app:layout_constraintTop_toTopOf="@+id/v_offline_bg"
        app:zdyFont="bold" />

</androidx.constraintlayout.widget.ConstraintLayout>
