<?xml version="1.0" encoding="utf-8"?>
<!--
    我的装扮卡（网格 2 列，与商城商品卡同款）

    与商城卡的区别只在底部：这里没有价格，动作是「佩戴 / 卸下」，
    佩戴中显示金色实底（可点即卸下），未佩戴显示金色描边。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_home_card_a"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_shop_preview">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_preview_char"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/c_gold"
            android:textSize="26sp"
            app:zdyFont="bold" />

    </FrameLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c_text_main"
        android:textSize="13sp" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c_text_second"
        android:textSize="10.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:textColor="@color/c_gold"
            android:textSize="11.5sp" />

    </LinearLayout>

</LinearLayout>
