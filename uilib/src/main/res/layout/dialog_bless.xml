<?xml version="1.0" encoding="utf-8"?>
<!-- 为愿望送祝福底部弹窗，对应原型「查看愿望并为他人祝愿」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sign_info_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="为他人的愿望祝愿"
        android:textColor="#2C1900"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_wish_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_wish_card"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="#2C1900"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_bless_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:gravity="start|top"
        android:hint="写下你的祝福（必填）"
        android:maxLength="255"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="#2C1900"
        android:textColorHint="#BBBBBB"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_bless_submit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_sign_button"
        android:gravity="center"
        android:text="祝愿"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
