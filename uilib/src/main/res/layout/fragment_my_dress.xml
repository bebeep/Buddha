<?xml version="1.0" encoding="utf-8"?>
<!--
    我的装扮

    与装扮商城同一套分类口径（灯具 / 佛龛 / 头像框 / 昵称 3D）与同一套卡片网格，
    用户从商城切到「我的装扮」时不用重新学一遍界面语言。
    灯油是消耗品，没有持有态，因此这里不设灯油分类。
    佩戴/卸下即时同步到拜佛页场景（服务端只存 id，场景按 id 对应的 resKey 换模型/贴图）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_my_dress"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 分类 chips：与商城一致的四类（灯油无持有态，不列） -->
    <HorizontalScrollView
        android:id="@+id/sv_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_cat_1"
                style="@style/shop_chip"
                android:text="@string/shop_cat_lamp" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_cat_2"
                style="@style/shop_chip"
                android:text="@string/shop_cat_shrine" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_cat_3"
                style="@style/shop_chip"
                android:text="@string/shop_cat_frame" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_cat_4"
                style="@style/shop_chip"
                android:text="@string/shop_cat_name3d" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="11dp"
        android:paddingTop="2dp"
        android:paddingEnd="11dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sv_category" />

    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rc_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rc_list">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_empty_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_my_dress_empty"
            android:textColor="@color/c_text_second"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_go_shop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="@string/shop_go_shop"
            android:textColor="@color/c_gold"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
