<?xml version="1.0" encoding="utf-8"?>
<!--
    我的装扮

    四类装扮的持有情况一屏看全，佩戴/卸下即时同步到拜佛页 3D 场景（服务端只存 id，
    场景按 id 对应的 resKey 换模型/贴图）。
    没有任何装扮时显示空态并给一个「去商城」入口，别让用户对着空列表发呆。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#251C10">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@mipmap/icon_back_black"
            android:tint="#EDE3D2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_my_dress"
            android:textColor="#EDE3D2"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title" />

    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_my_dress_empty"
            android:textColor="#8C8069"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_go_shop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="@string/shop_go_shop"
            android:textColor="#C4A265"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
