<?xml version="1.0" encoding="utf-8"?>
<!--
    我的装扮

    与装扮商城同一套分类口径（灯具 / 佛龛 / 头像框 / 昵称 3D）与同一套 ViewPager 范式，
    用户从商城切到「我的装扮」时不用重新学一遍界面语言。
    灯油是消耗品，没有持有态，因此这里不设灯油分类。
    从佛灯弹窗进入时宿主会把 ViewPager 锁在灯具页（手势与其余 tab 都禁用）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_my_dress"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 分类 tab：与商城一致的四类（灯油无持有态，不列） -->
    <com.fingertip.baselib.view.tablayout.ScaleTabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title"
        app:tl_indicator_color="@color/c_gold"
        app:tl_indicator_corner_radius="16dp"
        app:tl_indicator_height="3dp"
        app:tl_indicator_horizontal="CENTER"
        app:tl_indicator_width="18dp"
        app:tl_tab_padding="12dp"
        app:tl_textBold="BOTH"
        app:tl_textSelectColor="@color/c_gold_light"
        app:tl_textUnselectColor="@color/c_text_second" />

    <com.fingertip.uilib.view.LockableViewPager
        android:id="@+id/vp_my_dress"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
