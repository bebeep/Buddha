<?xml version="1.0" encoding="utf-8"?>
<!--
    编辑个人资料（暗调禅金重排，海外版 v1.5）
    头像（金环展示位，点击进我的装扮）→ 昵称（含「3D 效果」徽章开关，仅拥有昵称3D装扮时显示）
    → 签名 → 性别 → 保存（本页唯一金色实底）
    昵称/签名保存走服务端敏感词审核（scene 10/11），客户端不做本地词库。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#251C10">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@mipmap/icon_back_black"
            android:tint="#EDE3D2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_edit_title"
            android:textColor="#EDE3D2"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />
    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/tv_save"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 头像：金环展示位。换头像走 OSS 上传流程未接，点击先进我的装扮 -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_avatar_gold_ring"
                android:padding="3dp"
                android:scaleType="centerCrop" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_wear_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_home_inner_gold"
                android:text="@string/profile_edit_wear_hint"
                android:textColor="#C4A265"
                android:textSize="11sp" />

            <!-- 昵称卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_home_card_a"
                android:orientation="vertical"
                android:padding="14dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_edit_nickname"
                    android:textColor="#8C8069"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input_dark"
                    android:hint="@string/profile_edit_nickname_hint"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#EDE3D2"
                    android:textColorHint="#6B6152"
                    android:textSize="14sp" />

                <!-- 3D 效果徽章开关：仅当拥有昵称3D装扮时显示，开关即佩戴/摘下，立即生效 -->
                <LinearLayout
                    android:id="@+id/ll_name3d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_inner_gold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/profile_edit_3d_badge"
                        android:textColor="#C4A265"
                        android:textSize="11sp"
                        app:zdyFont="bold" />

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/profile_edit_3d_hint"
                        android:textColor="#8C8069"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_name3d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb_gold"
                        app:switchPadding="6dp"
                        app:track="@drawable/switch_track_gold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 签名卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card_a"
                android:orientation="vertical"
                android:padding="14dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_edit_mood"
                    android:textColor="#8C8069"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_mood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input_dark"
                    android:gravity="top"
                    android:hint="@string/profile_edit_mood_hint"
                    android:maxLength="100"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="#EDE3D2"
                    android:textColorHint="#6B6152"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 性别卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card_a"
                android:orientation="vertical"
                android:padding="14dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_edit_gender"
                    android:textColor="#8C8069"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_secret"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#C4A265"
                        android:checked="true"
                        android:text="@string/gender_secret"
                        android:textColor="#B8AC96"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_male"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:buttonTint="#C4A265"
                        android:text="@string/gender_male"
                        android:textColor="#B8AC96"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_female"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:buttonTint="#C4A265"
                        android:text="@string/gender_female"
                        android:textColor="#B8AC96"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tv_save"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_home_gold_btn"
        android:gravity="center"
        android:text="@string/profile_edit_save"
        android:textColor="#3A2E12"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
