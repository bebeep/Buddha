<?xml version="1.0" encoding="utf-8"?>
<!--
    首页区块 2：今日修持
    头部「今日修持」+ 连签天数 + 右上角主按钮「开始早课」（早课全完成后置灰为「早课已完成」）；
    下面五格对应早课五步（礼佛/诵经/念佛/发愿/回向），每格圆形单字 + 标题 + 完成态（右上角金勾）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_home_card_a"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="@string/home_block_practice"
            android:textColor="@color/c_text_main"
            android:textSize="13sp" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- 第一步：礼佛 -->
        <LinearLayout
            android:id="@+id/ll_slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_1_char"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_circle"
                    android:gravity="center"
                    android:text="礼"
                    android:textColor="@color/c_gold"
                    android:textSize="13sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_1_check"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_home_dot_gold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="8sp"
                    android:visibility="gone" />

            </FrameLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_slot_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/early_practice_step_worship"
                android:textColor="@color/c_text_main"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- 第二步：诵经 -->
        <LinearLayout
            android:id="@+id/ll_slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_2_char"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_circle"
                    android:gravity="center"
                    android:text="诵"
                    android:textColor="@color/c_gold"
                    android:textSize="13sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_2_check"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_home_dot_gold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="8sp"
                    android:visibility="gone" />

            </FrameLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_slot_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/early_practice_step_chant"
                android:textColor="@color/c_text_main"
                android:textSize="10sp" />


        </LinearLayout>

        <!-- 第三步：念佛 -->
        <LinearLayout
            android:id="@+id/ll_slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_3_char"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_circle"
                    android:gravity="center"
                    android:text="念"
                    android:textColor="@color/c_gold"
                    android:textSize="13sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_3_check"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_home_dot_gold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="8sp"
                    android:visibility="gone" />

            </FrameLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_slot_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/early_practice_step_nianfo"
                android:textColor="@color/c_text_main"
                android:textSize="10sp" />


        </LinearLayout>

        <!-- 第四步：发愿 -->
        <LinearLayout
            android:id="@+id/ll_slot_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_4_char"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_circle"
                    android:gravity="center"
                    android:text="愿"
                    android:textColor="@color/c_gold"
                    android:textSize="13sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_4_check"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_home_dot_gold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="8sp"
                    android:visibility="gone" />

            </FrameLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_slot_4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/early_practice_step_vow"
                android:textColor="@color/c_text_main"
                android:textSize="10sp" />


        </LinearLayout>

        <!-- 第五步：回向 -->
        <LinearLayout
            android:id="@+id/ll_slot_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_5_char"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_circle"
                    android:gravity="center"
                    android:text="回"
                    android:textColor="@color/c_gold"
                    android:textSize="13sp" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_slot_5_check"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_home_dot_gold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/c_text_on_gold"
                    android:textSize="8sp"
                    android:visibility="gone" />

            </FrameLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_slot_5_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/early_practice_step_share"
                android:textColor="@color/c_text_main"
                android:textSize="10sp" />


        </LinearLayout>

    </LinearLayout>

</LinearLayout>
