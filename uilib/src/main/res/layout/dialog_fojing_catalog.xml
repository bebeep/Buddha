<?xml version="1.0" encoding="utf-8"?>
<!--
  这一层撑满 BottomSheet 容器，实际高度由 FojingCatalogDialog.onStart 按屏幕定，
  里面的列表用 weight 吃满剩余空间。不要在布局里写死高度：
  BottomSheetDialog 拼内容时会重设 layout params，写死的值不算数。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rec_top_24dp"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_catalog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="目录"
            android:textColor="#2C1900"
            android:textSize="18sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_catalog_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:textColor="#B3A48E"
            android:textSize="12sp" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_catalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_catalog_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="目录还没加载出来"
            android:textColor="#B3A48E"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
