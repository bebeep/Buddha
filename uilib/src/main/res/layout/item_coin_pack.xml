<?xml version="1.0" encoding="utf-8"?>
<!--
    充值档位卡（网格 3 列）

    竖版结构：币数 → 赠送 → 价格胶囊 → 划线原价（可选）。
    首充优惠档右上角挂「首充」角标；优惠已用掉后角标变灰「已使用」、整卡降透明度。
    三列一行宽度只有 ~100dp，币数用大号数字、单位另起一行，
    赠送行即使没有也用 minHeight 撑住，保证同一行卡片等高。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:id="@+id/ll_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_card_a"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="14dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_coin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/c_text_main"
            android:textSize="18sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/recharge_coin_unit"
            android:textColor="@color/c_text_second"
            android:textSize="10sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="15dp"
            android:textColor="@color/c_gold"
            android:textSize="10sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_home_pill_outline"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/c_gold"
            android:textSize="12sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_ori_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/c_text_second"
            android:textSize="9sp"
            android:visibility="gone" />

    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_first_charge_badge"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="@string/recharge_first_charge_badge"
        android:textColor="@color/color_w"
        android:textSize="8sp"
        android:visibility="gone"
        app:zdyFont="bold" />

</FrameLayout>
