<?xml version="1.0" encoding="utf-8"?>
<!--
    首页（海外版·暗调禅金）
    六区块走单个 RecyclerView 多 viewType，外面套 SmartRefreshLayout 做整页下拉刷新；
    不用 ScrollView 套 RecyclerView，避免嵌套滚动打架。
    根布局用 FullTopConstraintLayout 让背景铺到状态栏下（暗底才不会在顶部断一条），
    内容自己从状态栏下方开始。
    区块顺序由服务端 blocks 下发，前端默认为：
      佛历头卡 / 今日修持 / 供灯条 / 金刚区 / 游戏卡 / 佛友圈精选
-->
<com.fingertip.baselib.view.FullTopConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!-- 首屏聚合接口失败：给一条重试出口，别让页面空着 -->
    <LinearLayout
        android:id="@+id/ll_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_load_fail"
            android:textColor="@color/c_text_second"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/home_retry"
            android:textColor="@color/c_gold"
            android:textSize="12sp" />

    </LinearLayout>

</com.fingertip.baselib.view.FullTopConstraintLayout>
