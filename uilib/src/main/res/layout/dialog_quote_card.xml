<?xml version="1.0" encoding="utf-8"?><!--
    禅语日签详情弹窗：首页「佛友圈精选」里补位卡的详情。
    内容全部来自本地 DailyQuotes（经藏原文 + 出处），没有动态 id，
    所以做成弹窗而不是跳动态详情页；底部留一个去佛友圈的入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="76dp">

    <!-- paddingBottom 76dp 是给底部 tab 栏让位：sheet 贴底时卡片不要压在 tab 上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quote_dialog_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_moment_dot_gold" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="禅语日签"
                android:textColor="@color/c_gold"
                android:textSize="11sp"
                tools:text="禅语日签" />
        </LinearLayout>

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="10dp"
            android:textColor="@color/c_text_main"
            android:textSize="19sp"
            app:zdyFont="bold"
            tools:text="一切有为法，如梦幻泡影，如露亦如电，应作如是观。" />

        <View
            android:layout_width="36dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/c_ff4a3c22" />

        <TextView
            android:id="@+id/tv_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/c_gold"
            android:textSize="12sp"
            tools:text="《金刚经》" />

        <TextView
            android:id="@+id/tv_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="原文摘录，未作改写"
            android:textColor="@color/c_ff7a6f5c"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_go_moment"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_sign_button"
        android:gravity="center"
        android:text="去佛友圈看看"
        android:textColor="@color/c_text_on_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="轻点空白处关闭"
        android:textColor="@color/c_ff6e6454"
        android:textSize="10sp" />
</LinearLayout>
