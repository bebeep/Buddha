<?xml version="1.0" encoding="utf-8"?>
<!--
    供灯（静态骨架）
    正式形态是拜佛 tab 的 3D 佛龛场景，这里先做二级页静态骨架：
    场景区占位块 + 续燃卡 + 装扮三格。续燃按钮本期只提示「即将上线」。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lamp_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp">

            <!-- 3D 佛龛场景占位：后续换 EQ-Renderer 的 SceneLayout -->
            <FrameLayout
                android:id="@+id/fl_scene"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_home_dashed">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/lamp_scene_placeholder"
                    android:textColor="@color/c_text_second"
                    android:textSize="11sp" />

            </FrameLayout>

            <!-- 续燃卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card_b"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.fingertip.baselib.view.MyTextView
                        android:id="@+id/tv_lamp_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_lamp_default_name"
                        android:textColor="@color/c_text_main"
                        android:textSize="14sp" />

                    <com.fingertip.baselib.view.MyTextView
                        android:id="@+id/tv_lamp_remain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_lamp_dying_desc"
                        android:textColor="@color/c_text_second"
                        android:textSize="10.5sp" />

                </LinearLayout>

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_relight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_home_pill_outline"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/lamp_relight"
                    android:textColor="@color/c_gold"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 装扮三格：灯具 / 佛龛场景 / 佛像，后续直挂商城 -->
            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.04"
                android:text="@string/lamp_dress_title"
                android:textColor="@color/c_text_main"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_dress_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_inner"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_home_circle"
                        android:gravity="center"
                        android:text="灯"
                        android:textColor="@color/c_gold"
                        android:textSize="13sp" />

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="灯具"
                        android:textColor="@color/c_text_third"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_dress_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2.5dp"
                    android:layout_marginEnd="2.5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_inner"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_home_circle"
                        android:gravity="center"
                        android:text="龛"
                        android:textColor="@color/c_gold"
                        android:textSize="13sp" />

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="佛龛场景"
                        android:textColor="@color/c_text_third"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_dress_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_inner"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_home_circle"
                        android:gravity="center"
                        android:text="油"
                        android:textColor="@color/c_gold"
                        android:textSize="13sp" />

                    <com.fingertip.baselib.view.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/lamp_dress_oil"
                        android:textColor="@color/c_text_third"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 合规：付费与虚拟物品说明，先在占位页留位 -->
            <com.fingertip.baselib.view.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/early_practice_disclaimer"
                android:textColor="@color/c_text_hint"
                android:textSize="10sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
