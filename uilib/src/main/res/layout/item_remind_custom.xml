<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义提醒单条：文案 + 每天几点 + 删除。只在自定义那一类里用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_home_inner_gold"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/c_text_main"
            android:textSize="13sp"
            tools:text="晚课诵经" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/c_text_second"
            android:textSize="10.5sp"
            tools:text="每天 20:00" />

    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_switch"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/c_gold"
        android:textSize="11.5sp"
        tools:text="已开启" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_delete"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/remind_delete"
        android:textColor="@color/c_text_second"
        android:textSize="11.5sp" />

</LinearLayout>
