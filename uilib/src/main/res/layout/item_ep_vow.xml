<?xml version="1.0" encoding="utf-8"?>
<!-- 早课第四步：发愿。可手写，也可一键带入历史愿文。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_card_a"
    android:orientation="vertical"
    android:padding="16dp">

    <com.fingertip.baselib.view.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ep_vow_tip"
        android:textColor="@color/c_text_third"
        android:textSize="12sp" />

    <!-- 编辑区固定占屏高 1/3（运行时按 displayMetrics 设），字数右下角叠加 -->
    <FrameLayout
        android:id="@+id/fl_vow_editor"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/et_vow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_inner"
            android:gravity="top|start"
            android:hint="@string/ep_vow_hint"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="6dp"
            android:maxLength="200"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="34dp"
            android:textColor="@color/c_text_main"
            android:textColorHint="@color/c_text_hint"
            android:textSize="13sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_vow_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            android:text="0/200"
            android:textColor="@color/c_text_hint"
            android:textSize="11sp" />
    </FrameLayout>

    <com.fingertip.baselib.view.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ep_vow_history"
        android:textColor="@color/c_gold"
        android:textSize="12sp" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_vow_history_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ep_vow_history_empty"
        android:textColor="@color/c_text_hint"
        android:textSize="11.5sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/ll_vow_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
