<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sign_info_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lamp_action_title"
            android:textColor="@color/c_text_main"
            android:textSize="18sp"
            app:zdyFont="bold" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/icon_sign_in_close" />
    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/c_text_second"
        android:textSize="13sp"
        tools:text="佛灯燃烧中，剩余 36 小时" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_mode_light"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_worship_price_normal"
            android:gravity="center"
            android:text="@string/lamp_action_light"
            android:textColor="@color/c_text_second"
            android:textSize="14sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_mode_relight"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_worship_price_normal"
            android:gravity="center"
            android:text="@string/lamp_action_relight"
            android:textColor="@color/c_text_second"
            android:textSize="14sp"
            app:zdyFont="bold" />
    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_oil_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lamp_action_oil_title"
        android:textColor="@color/c_text_main"
        android:textSize="14sp"
        app:zdyFont="bold" />

    <LinearLayout
        android:id="@+id/ll_oils"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/c_text_second"
        android:textSize="12sp"
        tools:text="我的功德币：1000" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_submit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:text="@string/lamp_action_light"
        android:textColor="@color/c_text_on_gold"
        android:textSize="16sp"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_switch_dress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/lamp_action_switch_dress"
        android:textColor="@color/c_gold"
        android:textSize="13sp" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/lamp_action_hint"
        android:textColor="@color/c_text_hint"
        android:textSize="11sp" />

</LinearLayout>
