<?xml version="1.0" encoding="utf-8"?>
<!--
    早课五步流程（礼佛 → 诵经 → 念佛 → 发愿 → 回向）。
    五步同页：ViewPager2 左右滑动切换，顶部展示第几步/共五步及完成状态，
    底部一个主按钮（下一步 / 开始诵经 / 完成早课），按当前步完成条件置灰或点亮。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/early_practice_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="@color/c_gold"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 当前步骤名 + 五步完成状态（✓=已完成，数字=当前/未到） -->
    <LinearLayout
        android:id="@+id/ll_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/cl_title">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_step_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/c_gold_light"
            android:textSize="12sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_dot1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="1"
            android:textSize="11sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_dot2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="2"
            android:textSize="11sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_dot3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="3"
            android:textSize="11sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_dot4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="4"
            android:textSize="11sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_dot5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="5"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 五步页面容器 + 完成态覆盖层 -->
    <FrameLayout
        android:id="@+id/fl_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/ll_tabs"
        app:layout_constraintTop_toBottomOf="@id/ll_dots">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_steps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/ll_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_card_b"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:visibility="gone">

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_home_dot_gold"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/c_text_on_gold"
                android:textSize="18sp" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/c_gold_light"
                android:textSize="18sp"
                app:zdyFont="bold" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_result_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/c_text_third"
                android:textSize="12.5sp" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_result_milestone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/c_text_second"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部步骤 tab：只能点这里切换（ViewPager2 手势已禁），完成态用金色字 -->
    <LinearLayout
        android:id="@+id/ll_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tv_action">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/early_practice_step_worship"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/early_practice_step_chant"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/early_practice_step_nianfo"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/early_practice_step_vow"
            android:textSize="12sp" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_tab5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/early_practice_step_share"
            android:textSize="12sp" />
    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_action"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ep_primary_off"
        android:gravity="center"
        android:text="@string/ep_next"
        android:textColor="@color/c_text_second"
        android:textSize="13.5sp"
        app:layout_constraintBottom_toTopOf="@id/tv_disclaimer" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="@string/early_practice_disclaimer"
        android:textColor="@color/c_text_hint"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
