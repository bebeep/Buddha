<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sign_info_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="供佛"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:zdyFont="bold" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@mipmap/icon_sign_in_close" />
    </LinearLayout>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_buddha_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        tools:text="供奉「释迦牟尼佛」" />

    <!-- 价目列表，代码动态填充 -->
    <LinearLayout
        android:id="@+id/ll_prices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#999999"
        android:textSize="12sp"
        tools:text="我的功德币：1000" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_submit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:text="确定"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:zdyFont="bold" />

    <com.fingertip.baselib.view.MyTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="供佛期间可持续获得功德收益，续供自动顺延"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />
</LinearLayout>
