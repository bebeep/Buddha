<?xml version="1.0" encoding="utf-8"?>
<!--
    古刹详情·历史时间线单项：左列竖线+金点节点，右列年份+史实内容
    templeHistory 为 JSON 数组 [{year, content}]，逐条 inflate 到 ll_history
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="match_parent">

        <View
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="2dp"
            android:background="@color/c_line" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_timeline_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/tv_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/c_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="东汉" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingBottom="14dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/c_text_third"
            android:textSize="13sp"
            tools:text="白马寺创建，中国第一座官办寺院" />
    </LinearLayout>
</LinearLayout>
