<?xml version="1.0" encoding="utf-8"?>
<!--
    提醒规则编辑弹窗：文案（仅自定义提醒显示）+ 时刻选择。
    时刻用 15 个小格而不是滚轮——只有 06:00~20:00 这 15 个选项，格子少两次手势。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fingertip.baselib.view.shapeview.ShapeConstraintLayout
        android:id="@+id/cl_content"
        style="@style/constraint_center"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:gdBgColor="#342919"
        app:gdRadius="18dp">

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/remind_dialog_time_title"
            android:textColor="#EDE3D2"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/remind_dialog_time_sub"
            android:textColor="#8C8069"
            android:textSize="10.5sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <!-- 只有自定义提醒需要填文案 -->
        <EditText
            android:id="@+id/et_text"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_login_input_dark"
            android:hint="@string/remind_dialog_text_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="20"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#EDE3D2"
            android:textColorHint="#5E5648"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tv_hint" />

        <LinearLayout
            android:id="@+id/ll_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/et_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_hours">

            <com.fingertip.baselib.view.shapeview.ShapeTextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/remind_dialog_cancel"
                android:textColor="#B8AC96"
                android:textSize="14sp"
                app:gdBgColor="#3D301E"
                app:gdRadius="22dp" />

            <com.fingertip.baselib.view.shapeview.ShapeTextView
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/remind_dialog_confirm"
                android:textColor="#1C1611"
                android:textSize="14sp"
                app:gdEndColor="#DCBE84"
                app:gdGradientOrientation="LEFT_RIGHT"
                app:gdRadius="22dp"
                app:gdStartColor="#C4A265"
                app:zdyFont="bold" />

        </LinearLayout>

    </com.fingertip.baselib.view.shapeview.ShapeConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
