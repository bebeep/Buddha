<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="14dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_home_card_a"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:layout_height="wrap_content">


    <com.fingertip.baselib.view.shapeview.ShapeImageView
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/iv_head"
        app:radius="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="40dp"
        android:src="@mipmap/icon_default_head"
        android:layout_height="40dp"/>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_name"
        android:textColor="@color/c_text_main"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/iv_head"
        android:text="匿名用户"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@+id/iv_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


    <!-- 等级徽章：服务端按级下发的药丸图，lv 数字画在图里 -->
    <ImageView
        android:id="@+id/iv_level_tag"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        android:layout_width="42dp"
        android:layout_marginStart="4dp"
        android:layout_height="14dp"/>

    <TextView
        android:id="@+id/tv_level"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        app:layout_constraintStart_toEndOf="@+id/iv_level_tag"
        android:layout_width="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="12sp"
        android:textColor="@color/c_text_second"
        android:text="菩提初生"
        android:layout_height="wrap_content"/>

    <!-- 共修打卡徽标：checkIn=1 才显示 -->
    <TextView
        android:id="@+id/tv_checkin_tag"
        app:layout_constraintBottom_toBottomOf="@+id/tv_level"
        app:layout_constraintTop_toTopOf="@+id/tv_level"
        app:layout_constraintStart_toEndOf="@+id/tv_level"
        android:layout_width="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:textSize="10sp"
        android:textColor="@color/c_gold_light"
        android:text="共修打卡"
        android:background="@drawable/bg_checkin_tag"
        android:visibility="gone"
        android:layout_height="wrap_content"/>

    <com.fingertip.baselib.view.MyTextView
        android:layout_width="wrap_content"
        android:id="@+id/tv_follow"
        android:text="+关注"
        app:gdRadius="4dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textSize="12sp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/tv_follow_dark"

        android:background="@drawable/bg_follow_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tv_time_locate"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintStart_toEndOf="@+id/iv_head"
        android:layout_width="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textColor="@color/c_text_second"
        android:text="四川 · 1小时前"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tv_content"
        android:text="这是内容。。。。最多有两行"
        app:layout_constraintTop_toBottomOf="@+id/iv_head"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textColor="@color/c_ffd8ccba"
        android:lineSpacingExtra="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_image_video"
        android:layout_width="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_video"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:visibility="gone"
            app:cardMaxElevation="0dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="4dp"
            android:layout_marginHorizontal="4dp"
            android:layout_height="0dp">

            <com.fingertip.baselib.view.SampleCoverVideo
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- 透明层：接住点击，进全屏短视频页。播放器自己的手势在这里不需要 -->
            <View
                android:id="@+id/v_video_tap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/iv_hot_comment"
        android:layout_width="10dp"
        android:src="@drawable/icon_hot_comment"
        android:tint="@color/c_text_second"
        android:layout_marginTop="3dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/tv_hot_comment"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="12dp"/>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_hot_comment"
        app:layout_constraintTop_toBottomOf="@+id/fl_image_video"
        app:layout_constraintStart_toEndOf="@+id/iv_hot_comment"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:textColor="@color/c_text_second"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:text="这是一条热评，最多两行是这样的…这是一条热评，最多两行是这样的…最多两行是这样的…"
        android:layout_marginStart="4dp"
        android:layout_height="wrap_content"/>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/gp_hot_comment"
        app:constraint_referenced_ids="iv_hot_comment,tv_hot_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_like"
        app:layout_constraintTop_toBottomOf="@+id/tv_hot_comment"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/c_text_second"
        android:text="0"
        android:layout_marginStart="16dp"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/bg_moment_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_comment"
        app:layout_constraintTop_toTopOf="@+id/tv_like"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/c_text_second"
        android:text="0"
        android:drawablePadding="4dp"
        android:drawableTint="@color/c_text_second"
        android:drawableStart="@drawable/icon_moment_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


    <ImageView
        android:id="@+id/iv_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_like"
        app:layout_constraintBottom_toBottomOf="@+id/tv_like"
        android:paddingVertical="9dp"
        android:paddingStart="18dp"
        android:src="@drawable/icon_moment_close"
        android:tint="@color/c_text_hint"
        android:layout_width="wrap_content"
        android:paddingEnd="24dp"
        android:layout_height="32dp"/>

    <View
        android:id="@+id/v_divider"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_like"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:background="@color/c_gold_12"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>




