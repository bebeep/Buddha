<?xml version="1.0" encoding="utf-8"?>
<!--
    修行等级详情页（个人中心「修行值」点进来的二级页）

    结构：标题栏 → 当前等级卡（徽章/头衔/经验进度）→ 修行值说明 → 十二重境界概览
          → 底部「查看全部等级表」进三级页。
    数据口径全部来自 user_level_config（globalParam 下发），页面不写死任何等级/经验数字：
    后台改一列 exp 或 levelTag，这里跟着变。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_all"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="@string/level_all_entry"
            android:textColor="@color/c_gold"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- ============ 当前等级 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_inner"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 等级徽章：服务端按级下发的药丸图（lv 数字画在图里），
                         配置缺失时退化为 tv_badge_lv 的段色文字 -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="32dp">

                        <ImageView
                            android:id="@+id/iv_badge_img"
                            android:layout_width="96dp"
                            android:layout_height="32dp"
                            android:scaleType="fitXY"
                            tools:visibility="visible" />

                        <com.fingertip.baselib.view.MyTextView
                            android:id="@+id/tv_badge_lv"
                            android:layout_width="96dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="lv12"
                            android:textSize="15sp"
                            android:visibility="gone"
                            app:zdyFont="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.fingertip.baselib.view.MyTextView
                            android:id="@+id/tv_cur_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/c_text_main"
                            android:textSize="20sp"
                            app:zdyFont="bold"
                            tools:text="三阶·居士" />

                        <com.fingertip.baselib.view.MyTextView
                            android:id="@+id/tv_cur_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/c_text_second"
                            android:textSize="12sp"
                            tools:text="第 13 级 · 共 101 级" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/c_gold_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.fingertip.baselib.view.MyTextView
                        android:id="@+id/tv_exp_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/c_gold"
                        android:textSize="13sp"
                        app:zdyFont="bold"
                        tools:text="120 / 162 修行值" />

                    <com.fingertip.baselib.view.MyTextView
                        android:id="@+id/tv_exp_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/c_text_second"
                        android:textSize="12sp"
                        tools:text="74%" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_exp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_level" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_next_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/c_text_second"
                    android:textSize="12sp"
                    tools:text="距「四阶·居士」还需 42 修行值" />
            </LinearLayout>

            <!-- ============ 修行值是什么 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_inner"
                android:orientation="vertical"
                android:padding="16dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/level_what_title"
                    android:textColor="@color/c_text_main"
                    android:textSize="15sp"
                    app:zdyFont="bold" />

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/level_what_body"
                    android:textColor="@color/c_text_second"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ============ 修行值怎么涨 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_inner"
                android:orientation="vertical"
                android:padding="16dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/level_gain_title"
                    android:textColor="@color/c_text_main"
                    android:textSize="15sp"
                    app:zdyFont="bold" />

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/level_gain_body"
                    android:textColor="@color/c_text_second"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ============ 十二重境界概览 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_inner"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <com.fingertip.baselib.view.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/level_stage_title"
                    android:textColor="@color/c_text_main"
                    android:textSize="15sp"
                    app:zdyFont="bold" />

                <com.fingertip.baselib.view.MyTextView
                    android:id="@+id/tv_stage_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/c_text_second"
                    android:textSize="12sp"
                    tools:text="从「凡夫」到「妙觉」共十二重境界，每一重下有九个阶位" />

                <!-- 段列表由代码按 LevelUtil.STAGES 动态填充（数量随服务端配置变，不写死在布局里） -->
                <LinearLayout
                    android:id="@+id/ll_stages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ 全部等级表入口 ============ -->
            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_all_levels"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_gold_btn"
                android:gravity="center"
                android:text="@string/level_all_levels_btn"
                android:textColor="@color/shop_text_on_gold"
                android:textSize="14sp"
                app:zdyFont="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
