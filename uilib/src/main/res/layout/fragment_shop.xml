<?xml version="1.0" encoding="utf-8"?>
<!--
    装扮商店

    结构：标题栏（返回 / 标题 / 我的装扮）→ 分类 tab → ViewPager（四个独立分类页）→ 底部合规小字。
    底部那行「虚拟物品不支持退款 · 恢复购买在设置」是审核员真的会看的位置，别删。
    分类页各自持有自己的列表与空态，点 tab 与左右滑都只改 ViewPager 的 currentItem。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg_page">

    <com.fingertip.baselib.view.FullTopConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_back_black"
            android:tint="@color/c_text_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.fingertip.baselib.view.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shop_title"
            android:textColor="@color/c_text_main"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_my_dress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_home_pill_outline"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/shop_my_dress"
            android:textColor="@color/c_gold"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.fingertip.baselib.view.FullTopConstraintLayout>

    <!-- 分类 tab：灯油是消耗品，已移到拜佛页佛灯弹窗，商店只摆 4 类永久装扮 -->
    <com.fingertip.baselib.view.tablayout.ScaleTabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title"
        app:tl_indicator_color="@color/c_gold"
        app:tl_indicator_corner_radius="16dp"
        app:tl_indicator_height="3dp"
        app:tl_indicator_horizontal="CENTER"
        app:tl_indicator_width="18dp"
        app:tl_tab_padding="12dp"
        app:tl_textBold="BOTH"
        app:tl_textSelectColor="@color/c_gold_light"
        app:tl_textUnselectColor="@color/c_text_second" />

    <com.fingertip.uilib.view.LockableViewPager
        android:id="@+id/vp_shop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/tv_tip"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/shop_tip"
        android:textColor="@color/c_text_hint"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
