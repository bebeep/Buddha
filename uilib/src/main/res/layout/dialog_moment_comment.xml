<?xml version="1.0" encoding="utf-8"?>
<!--
  短视频全屏页的评论面板。
  全屏透明根布局：点击上半部分空白关闭，底部是白色圆角面板（高度由代码按屏幕比例设置）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 空白遮罩：点击关闭面板 -->
    <View
        android:id="@+id/v_outside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/ll_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_rec_top_24dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_comment_drag_handle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:textColor="#2D2D2D"
                android:textSize="15sp"
                android:textStyle="bold"
                app:zdyFont="medium"
                tools:text="全部评论(12)" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="关闭"
                android:padding="7dp"
                android:src="@mipmap/icon_moment_close" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F7F7F7" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/srl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srlEnableRefresh="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_comment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    tools:listitem="@layout/item_comment" />

            </com.scwang.smart.refresh.layout.SmartRefreshLayout>

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="还没有评论，来说两句"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F7F7F7" />

        <!-- 输入区：输入框常驻，点击某条评论会切成「回复 xxx」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_moment_comment_input"
                android:minHeight="40dp">

                <com.fingertip.baselib.view.MyEditText
                    android:id="@+id/et_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="44dp"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="善语结善缘，说点什么吧"
                    android:imeOptions="actionSend"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine"
                    android:lineSpacingExtra="3dp"
                    android:maxLength="300"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:textColor="#050505"
                    android:textCursorDrawable="@drawable/bg_comment_curser"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iv_send"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="发送"
                    android:padding="5dp"
                    android:src="@drawable/bg_iv_send" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
