<?xml version="1.0" encoding="utf-8"?>
<!-- 抄经格子（仅保留作视觉规格参考，已不再 inflate；实际格子由
     FojingCopyAdapter.onCreateViewHolder 纯代码构建，进页性能优化） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginTop="5dp">

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_default"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:text="观"
        android:textSize="18sp"
        android:textColor="@color/c_gold_20"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:background="@color/c_gold_15" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="@color/c_gold_15" />

    <View
        android:id="@+id/v_line_left"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="40dp"
        android:background="@color/c_gold_15" />
    <View
        android:id="@+id/v_line_right"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="40dp"
        android:visibility="gone"
        android:background="@color/c_gold_15" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_copy"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:text="关"
        android:textSize="30sp"
        android:textColor="@color/c_text_main"
        android:gravity="center"
        android:background="@drawable/bg_fojing_copy_item" />

</FrameLayout>
