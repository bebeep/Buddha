<?xml version="1.0" encoding="utf-8"?>
<!--
  登录页（海外版）：Google + 邮箱，无手机号、无微信。
  暗调禅金：底 #251C10，主金 #C4A265，全屏只有一个金色实底（主按钮）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#251C10"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/login_brand"
            android:src="@drawable/ic_login_logo" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.18"
            android:text="@string/login_brand"
            android:textColor="#E3C88B"
            android:textSize="30sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="@string/login_slogan"
            android:textColor="#8C8069"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- Google：白底按钮，符合 Google 品牌规范；未配置 client id 时整块隐藏 -->
        <LinearLayout
            android:id="@+id/ll_google"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_login_google"
            android:gravity="center"
            android:orientation="horizontal">

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="19sp"
                app:zdyFont="bold" />

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/login_google"
                android:textColor="#1F1F1F"
                android:textSize="15sp"
                app:zdyFont="medium" />
        </LinearLayout>

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/login_or_email"
            android:textColor="#6B6259"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_input_dark"
            android:hint="@string/login_email_hint"
            android:inputType="textEmailAddress"
            android:maxLength="128"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#EDE3D2"
            android:textColorHint="#6B6259"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_input_dark"
            android:hint="@string/login_password_hint"
            android:inputType="textPassword"
            android:maxLength="64"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#EDE3D2"
            android:textColorHint="#6B6259"
            android:textSize="15sp" />

        <!-- 注册模式的二次密码确认，登录模式隐藏 -->
        <EditText
            android:id="@+id/et_password_again"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_input_dark"
            android:hint="@string/login_password_again_hint"
            android:inputType="textPassword"
            android:maxLength="64"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#EDE3D2"
            android:textColorHint="#6B6259"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_email_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:text="@string/login_email_ok"
            android:textColor="#C4A265"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_ep_primary"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/login_action_login"
            android:textColor="#14100C"
            android:textSize="16sp"
            app:zdyFont="bold" />

        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_switch_mode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_to_register"
            android:textColor="#C4A265"
            android:textSize="13sp" />

        <!-- 游客进入：服务端按设备号建/找回游客号，享正式账号全部功能；
             之后用 Google/Apple 登录会直接绑到这个号上，数据不丢 -->
        <com.fingertip.baselib.view.MyTextView
            android:id="@+id/tv_guest"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/login_guest"
            android:textColor="#8A7F70"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 协议：审核必查。缺了这一段，iOS 5.1.1 与 Google Play 都可能直接拒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_agreement_prefix"
                android:textColor="#6B6259"
                android:textSize="11sp" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_terms"
                android:textColor="#B5A78F"
                android:textSize="11sp" />

            <com.fingertip.baselib.view.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_and"
                android:textColor="#6B6259"
                android:textSize="11sp" />

            <com.fingertip.baselib.view.MyTextView
                android:id="@+id/tv_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_privacy"
                android:textColor="#B5A78F"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
