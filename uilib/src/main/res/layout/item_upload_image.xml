<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    android:background="@drawable/bg_upload_image_add"
    android:layout_height="wrap_content">


    <com.fingertip.baselib.view.shapeview.ShapeImageView
        android:id="@+id/iv_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:radius="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 上传状态半透明遮罩 -->
    <View
        android:id="@+id/v_status_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_photo"
        app:layout_constraintBottom_toBottomOf="@id/iv_photo"
        app:layout_constraintLeft_toLeftOf="@id/iv_photo"
        app:layout_constraintRight_toRightOf="@id/iv_photo" />

    <!-- 上传中：旋转加载指示器 -->
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_photo"
        app:layout_constraintBottom_toBottomOf="@id/iv_photo"
        app:layout_constraintLeft_toLeftOf="@id/iv_photo"
        app:layout_constraintRight_toRightOf="@id/iv_photo" />

    <!-- 上传成功：绿色对勾 -->
    <TextView
        android:id="@+id/tv_success"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_upload_success"
        android:gravity="center"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_photo"
        app:layout_constraintBottom_toBottomOf="@id/iv_photo"
        app:layout_constraintLeft_toLeftOf="@id/iv_photo"
        app:layout_constraintRight_toRightOf="@id/iv_photo" />

    <!-- 上传失败：红色感叹号 -->
    <TextView
        android:id="@+id/tv_fail"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_upload_fail"
        android:gravity="center"
        android:text="!"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_photo"
        app:layout_constraintBottom_toBottomOf="@id/iv_photo"
        app:layout_constraintLeft_toLeftOf="@id/iv_photo"
        app:layout_constraintRight_toRightOf="@id/iv_photo" />


    <ImageView
        android:id="@+id/iv_add"
        android:src="@mipmap/icon_post_add"
        android:layout_width="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:visibility="gone"
        android:layout_height="24dp"/>

    <ImageView
        android:id="@+id/iv_delete"
        android:src="@mipmap/icon_post_delete"
        android:layout_width="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_height="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
