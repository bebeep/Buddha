<?xml version="1.0" encoding="utf-8"?><!-- 关注按钮描边：主金/弱色（原橙/灰） --><selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <stroke android:color="@color/c_gold" android:width="1dp" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <stroke android:color="@color/c_text_hint" android:width="1dp" />
        </shape>
    </item>
</selector>
