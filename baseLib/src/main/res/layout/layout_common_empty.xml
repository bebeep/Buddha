<?xml version="1.0" encoding="utf-8"?>
<!--
    通用空态占位（图 + 文）。
    由 TopRcAdapter 在列表数据为空时自动挂到 RecyclerView 上层显示，
    文案可通过 adapter.emptyText 配置，showEmptyTip 可整体关闭。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@null"
        android:src="@drawable/icon_common_empty" />

    <com.fingertip.baselib.view.MyTextView
        android:id="@+id/tv_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/empty_common_tip"
        android:textColor="@color/c_text_hint"
        android:textSize="13sp" />

</LinearLayout>
